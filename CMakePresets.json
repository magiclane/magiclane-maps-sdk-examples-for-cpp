{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 29,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base-vcpkg",
            "hidden": true,
            "binaryDir": "${sourceDir}/BUILD/${presetName}",
            "installDir": "${sourceDir}/INSTALL/${presetName}",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": {
                    "type": "FILEPATH",
                    "value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
                },
                "API_TOKEN": "$env{API_TOKEN}",
                "MAPS_SDK_DATA_PATH": "${sourceDir}/SDK/share",
                "VCPKG_FEATURE_FLAGS": "versions",
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo"
            }
        },
        {
            "name": "base-sanitizer",
            "hidden": true,
            "inherits": "base-vcpkg",
			"generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "cppcheck",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_CXX_CPPCHECK": "cppcheck;--enable=warning;--inconclusive;--force;--inline-suppr"
            }
        },
        {
            "name": "clang-tidy",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_CXX_CLANG_TIDY": "clang-tidy;--header-filter=${sourceDir}/*;-checks=-*,modernize-use-nullptr;-extra-arg=-std=c++17"
            }
        },
        {
            "name": "cpplint",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_CXX_CPPLINT": "cpplint"
            }
        },
        {
            "name": "iwyu",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_CXX_INCLUDE_WHAT_YOU_USE": "iwyu;-Xiwyu;any;-Xiwyu;iwyu;-Xiwyu"
            }
        },
        {
            "name": "lwyu",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_LINK_WHAT_YOU_USE": true
            }
        },
        {
            "name": "base-analyze-ninja-debug",
            "hidden": true,
            "inherits": [
                "base-vcpkg",
                "cppcheck",
                "clang-tidy",
				"cpplint"
            ],
			"generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux-glfw-ninja-debug",
            "description": "Build options for Linux 64-bit Debug build (+GLFW)",
            "inherits": "base-vcpkg",
			"generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "USE_GLFW": "ON",
                "VCPKG_MANIFEST_FEATURES": "glfw"
            },
            "condition": {
                "type": "notEquals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
